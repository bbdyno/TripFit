rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function availabilityPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/availability/$(uid);
    }

    function invitePath(inviteHash) {
      return /databases/$(database)/documents/invites/$(inviteHash);
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in get(roomPath(roomId)).data.memberUids;
    }

    function isOwner(roomId) {
      return signedIn() && get(roomPath(roomId)).data.ownerUid == request.auth.uid;
    }

    function isISODate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validRoomFields(data) {
      return data.keys().hasOnly([
          'ownerUid', 'memberUids', 'memberCount', 'title', 'destination', 'countryCode',
          'timezoneID', 'candidateStartDay', 'candidateEndDay', 'candidateDayCount',
          'durationDays', 'stage', 'confirmedStartDay', 'confirmedEndDay', 'updatedAt',
          'revision', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'ownerUid', 'memberUids', 'memberCount', 'title', 'destination', 'timezoneID',
          'candidateStartDay', 'candidateEndDay', 'candidateDayCount', 'durationDays',
          'stage', 'updatedAt', 'revision', 'schemaVersion'
        ])
        && data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128
        && data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 12
        && data.memberCount == data.memberUids.size()
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.destination is string && data.destination.size() <= 120
        && (!data.keys().hasAny(['countryCode']) || data.countryCode == null
          || (data.countryCode is string && data.countryCode.size() == 2))
        && data.timezoneID is string && data.timezoneID.size() >= 1 && data.timezoneID.size() <= 64
        && isISODate(data.candidateStartDay) && isISODate(data.candidateEndDay)
        && data.candidateStartDay <= data.candidateEndDay
        && data.candidateDayCount is int && data.candidateDayCount >= 1 && data.candidateDayCount <= 90
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 30
        && data.durationDays <= data.candidateDayCount
        && data.stage in ['coordinating', 'confirmed', 'completed', 'archived']
        && (!data.keys().hasAny(['confirmedStartDay']) || data.confirmedStartDay == null
          || isISODate(data.confirmedStartDay))
        && (!data.keys().hasAny(['confirmedEndDay']) || data.confirmedEndDay == null
          || isISODate(data.confirmedEndDay))
        && data.updatedAt == request.time
        && data.revision is int && data.revision >= 0
        && data.schemaVersion == 1;
    }

    function validRoomCreate(data) {
      return signedIn()
        && validRoomFields(data)
        && data.ownerUid == request.auth.uid
        && data.memberUids == [request.auth.uid]
        && data.memberCount == 1
        && data.stage == 'coordinating'
        && data.revision == 0;
    }

    function validOwnerRoomUpdate(roomId) {
      return isOwner(roomId)
        && validRoomFields(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.memberCount == resource.data.memberCount
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'destination', 'countryCode', 'timezoneID', 'candidateStartDay',
          'candidateEndDay', 'candidateDayCount', 'durationDays', 'stage',
          'confirmedStartDay', 'confirmedEndDay', 'updatedAt', 'revision'
        ]);
    }

    function validSelfJoin(roomId) {
      let memberAfter = getAfter(memberPath(roomId, request.auth.uid));
      let inviteHash = memberAfter.data.inviteHash;
      let inviteAfter = getAfter(invitePath(inviteHash));
      return signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && request.resource.data.memberCount <= 12
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'memberCount', 'updatedAt', 'revision'
        ])
        && memberAfter.data.uid == request.auth.uid
        && memberAfter.data.role == 'member'
        && inviteHash is string && inviteHash.matches('^[a-f0-9]{64}$')
        && inviteAfter.data.roomId == roomId
        && inviteAfter.data.revoked == false
        && inviteAfter.data.expiresAt > request.time
        && inviteAfter.data.lastJoinUid == request.auth.uid
        && inviteAfter.data.lastJoinAt == request.time;
    }

    function validSelfLeave(roomId) {
      return signedIn()
        && request.auth.uid != resource.data.ownerUid
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
        && request.resource.data.memberCount == resource.data.memberCount - 1
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'memberCount', 'updatedAt', 'revision'
        ])
        && !existsAfter(memberPath(roomId, request.auth.uid))
        && !existsAfter(availabilityPath(roomId, request.auth.uid));
    }

    function validMemberData(data, uid) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'role', 'isRequired', 'joinedAt', 'updatedAt',
          'schemaVersion', 'inviteHash'
        ])
        && data.keys().hasAll(['uid', 'role', 'isRequired', 'joinedAt', 'updatedAt', 'schemaVersion'])
        && data.uid == uid
        && (!data.keys().hasAny(['displayName']) || data.displayName == null
          || (data.displayName is string && data.displayName.size() <= 80))
        && data.role in ['owner', 'member']
        && data.isRequired is bool
        && data.joinedAt is timestamp
        && data.updatedAt == request.time
        && data.schemaVersion == 1
        && (!data.keys().hasAny(['inviteHash'])
          || (data.inviteHash is string && data.inviteHash.matches('^[a-f0-9]{64}$')));
    }

    function validMemberCreate(roomId, uid) {
      return signedIn() && request.auth.uid == uid
        && validMemberData(request.resource.data, uid)
        && request.auth.uid in getAfter(roomPath(roomId)).data.memberUids
        && ((getAfter(roomPath(roomId)).data.ownerUid == uid && request.resource.data.role == 'owner')
          || (request.resource.data.role == 'member'
            && request.resource.data.inviteHash is string
            && getAfter(invitePath(request.resource.data.inviteHash)).data.roomId == roomId));
    }

    function validAvailability(data, roomId, uid) {
      let room = get(roomPath(roomId)).data;
      return data.keys().hasOnly([
          'ownerUid', 'days', 'dayCount', 'firstDay', 'lastDay', 'statusValues',
          'leaveUnits', 'lateJoin', 'earlyLeave', 'note', 'updatedAt', 'revision',
          'schemaVersion'
        ])
        && data.keys().hasAll([
          'ownerUid', 'days', 'dayCount', 'firstDay', 'lastDay', 'statusValues',
          'leaveUnits', 'lateJoin', 'earlyLeave', 'updatedAt', 'revision', 'schemaVersion'
        ])
        && data.ownerUid == uid
        && data.days is list && data.days.size() >= 1 && data.days.size() <= 90
        && data.dayCount == data.days.size()
        && isISODate(data.firstDay) && isISODate(data.lastDay)
        && data.firstDay >= room.candidateStartDay && data.lastDay <= room.candidateEndDay
        && data.statusValues is list
        && data.statusValues.hasOnly(['available', 'maybe', 'unavailable', 'undecided'])
        && data.leaveUnits is number && data.leaveUnits >= 0 && data.leaveUnits <= room.durationDays
        && data.lateJoin is bool && data.earlyLeave is bool
        && (!data.keys().hasAny(['note']) || data.note == null
          || (data.note is string && data.note.size() <= 160))
        && data.updatedAt == request.time
        && data.revision is int && data.revision >= 0
        && data.schemaVersion == 1;
    }

    function validPacking(data, roomId) {
      return data.keys().hasOnly([
          'roomId', 'title', 'category', 'quantity', 'assigneeUid', 'isPacked',
          'createdByUid', 'updatedAt', 'revision', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'roomId', 'title', 'category', 'quantity', 'assigneeUid', 'isPacked',
          'createdByUid', 'updatedAt', 'revision', 'schemaVersion'
        ])
        && data.roomId == roomId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.category is string && data.category.size() <= 40
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 99
        && (data.assigneeUid == null || (data.assigneeUid is string && data.assigneeUid.size() <= 128))
        && data.isPacked is bool
        && data.createdByUid is string && data.createdByUid.size() <= 128
        && data.updatedAt == request.time
        && data.revision is int && data.revision >= 0
        && data.schemaVersion == 1;
    }

    function validPackingUpdate(roomId) {
      return validPacking(request.resource.data, roomId)
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.revision == resource.data.revision + 1
        && (isOwner(roomId)
          || (resource.data.assigneeUid == request.auth.uid
            && request.resource.data.assigneeUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isPacked', 'updatedAt', 'revision'
            ]))
          || (resource.data.assigneeUid == null
            && request.resource.data.assigneeUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'assigneeUid', 'updatedAt', 'revision'
            ])));
    }

    function validLookPlan(data, roomId, uid) {
      return data.keys().hasOnly([
          'roomId', 'ownerUid', 'day', 'outfitName', 'categories', 'paletteHex',
          'styleTags', 'formality', 'rainReady', 'note', 'updatedAt', 'revision',
          'schemaVersion'
        ])
        && data.keys().hasAll([
          'roomId', 'ownerUid', 'day', 'outfitName', 'categories', 'paletteHex',
          'styleTags', 'formality', 'rainReady', 'updatedAt', 'revision', 'schemaVersion'
        ])
        && data.roomId == roomId && data.ownerUid == uid
        && isISODate(data.day)
        && data.outfitName is string && data.outfitName.size() >= 1 && data.outfitName.size() <= 80
        && data.categories is list && data.categories.size() <= 12
        && data.paletteHex is list && data.paletteHex.size() <= 8
        && data.styleTags is list && data.styleTags.size() <= 12
        && data.formality is int && data.formality >= 0 && data.formality <= 5
        && data.rainReady is bool
        && (!data.keys().hasAny(['note']) || data.note == null
          || (data.note is string && data.note.size() <= 160))
        && data.updatedAt == request.time
        && data.revision is int && data.revision >= 0
        && data.schemaVersion == 1;
    }

    function validInviteCreate(inviteHash, data) {
      return signedIn()
        && inviteHash.matches('^[a-f0-9]{64}$')
        && data.keys().hasOnly([
          'roomId', 'createdByUid', 'expiresAt', 'revoked', 'createdAt', 'revision', 'schemaVersion'
        ])
        && data.keys().hasAll([
          'roomId', 'createdByUid', 'expiresAt', 'revoked', 'createdAt', 'revision', 'schemaVersion'
        ])
        && data.roomId is string && get(roomPath(data.roomId)).data.ownerUid == request.auth.uid
        && data.createdByUid == request.auth.uid
        && data.expiresAt is timestamp && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(30, 'd')
        && data.revoked == false && data.createdAt == request.time
        && data.revision == 0 && data.schemaVersion == 1;
    }

    function validInviteJoinStamp(inviteHash) {
      return signedIn()
        && resource.data.revoked == false && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastJoinUid', 'lastJoinAt', 'revision'
        ])
        && request.resource.data.lastJoinUid == request.auth.uid
        && request.resource.data.lastJoinAt == request.time
        && request.resource.data.revision == resource.data.revision + 1
        && request.auth.uid in getAfter(roomPath(resource.data.roomId)).data.memberUids
        && getAfter(memberPath(resource.data.roomId, request.auth.uid)).data.inviteHash == inviteHash;
    }

    match /users/{uid} {
      allow get, create, update, delete: if signedIn() && request.auth.uid == uid;
      allow list: if false;
    }

    match /rooms/{roomId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if validRoomCreate(request.resource.data);
      allow update: if validOwnerRoomUpdate(roomId) || validSelfJoin(roomId) || validSelfLeave(roomId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(roomId);
        allow create: if validMemberCreate(roomId, uid);
        allow update: if isOwner(roomId)
          || (signedIn() && request.auth.uid == uid
            && validMemberData(request.resource.data, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'updatedAt'
            ]));
        allow delete: if isOwner(roomId)
          || (signedIn() && request.auth.uid == uid
            && !(uid in getAfter(roomPath(roomId)).data.memberUids));
      }

      match /availability/{uid} {
        allow read: if isMember(roomId);
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(roomId)
          && validAvailability(request.resource.data, roomId, uid);
        allow delete: if isOwner(roomId) || (signedIn() && request.auth.uid == uid);
      }

      match /packingItems/{itemId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId) && validPacking(request.resource.data, roomId)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isMember(roomId) && validPackingUpdate(roomId);
        allow delete: if isOwner(roomId);
      }

      match /lookPlans/{planId} {
        allow read: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.ownerUid == request.auth.uid
          && validLookPlan(request.resource.data, roomId, request.auth.uid);
        allow delete: if isOwner(roomId)
          || (signedIn() && resource.data.ownerUid == request.auth.uid);
      }
    }

    match /invites/{inviteHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if validInviteCreate(inviteHash, request.resource.data);
      allow update: if isOwner(resource.data.roomId) || validInviteJoinStamp(inviteHash);
      allow delete: if isOwner(resource.data.roomId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
